{% liquid 

    assign name = block.settings.name
    assign review = block.settings.review
    assign rating = block.settings.rating 
    assign color_scheme = block.settings.color_scheme 
    

  

%} 
 

<div class="review color-{{ color_scheme }} gradient">
     
    <div class="reviewer"> 
        <h3>{{name}}</h3> 

        <div class="reviews">
            {% render 'review-icons', rate: rating %}
        </div>

        {% comment %} {% for i in (1..5) %}
            hello
        {% endfor %} {% endcomment %}
    </div>

    <p> {{review}} </p>
      
</div>

{%  schema  %} 
{ 
    "class": "swiper-slide",
    "name": "Review",
    "settings": [ 
         
        {
            "type": "text",
            "id": "name",
            "label": "Name",
            "default": "Benjamin Maaslans"
        },
        {
            "type": "inline_richtext",
            "id": "review",
            "label": "Review",
            "default": "2 weken geleden binnen gelopen om me te laten informeren over een elektrische fiets. Na een prettig geprek en deskundig advies een offerte mee gekregen. Vorige week de koop gesloten en vandaag de fiets met alle accessoires erop gemonteerd opgehaald. No nonsens verkoper met kennis van zaken. (Robin) Tot zover zeer tevreden. Er zitten meerdere beurten in het servicepakket dus ik ben benieuwd."
        },
        {
            "type": "range",
            "min": 1,
            "max": 5,
            "step": 0.5,
            "default": 5,
            "label": "Rating",
            "id": "rating"
        },

        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Slide Color",
            "default": "scheme-1"
        } 

    ],
    "presets": [
        {"name": "Review"}
    ]
}
{% endschema %}