{% comment %} {{ 'title.css' | asset_url | stylesheet_tag }} {% endcomment %}

{% liquid 

    assign subtitle = block.settings.subtitle
    assign title = block.settings.title
    assign content = block.settings.content

    assign btn_text = block.settings.btn_text
    assign btn_url = block.settings.btn_url
    assign btn_style = block.settings.btn_style
    

    



    assign block_width = block.settings.block_width
    assign block_width_phone = block.settings.block_width_phone
    assign color_scheme = block.settings.color_scheme
    assign title_max_width = block.settings.title_max_width
    assign content_max_width = block.settings.content_max_width
    assign title_size = block.settings.title_size
    assign title_margin_bottom = block.settings.title_margin_bottom

    assign block_padding_horizontal = block.settings.block_padding_horizontal
    assign block_padding_vertical = block.settings.block_padding_vertical



    assign logo = block.settings.logo
    assign review_text = block.settings.review_text
    assign rating = block.settings.rating
         

%}

{%  style  %}
#shopify-block-{{ block.id }}.block-title{

    --block_width : calc( {{block_width}} - var(--gap_horizontal)/2 ); 
    /* --block_width : {{block_width}}; */
    --title_max_width : {{title_max_width}}px;
    --title_margin_bottom : {{title_margin_bottom}}px;
    --content_max_width : {{content_max_width}}px;

    --block_padding_horizontal : {{block_padding_horizontal}}px;
    --block_padding_vertical : {{block_padding_vertical}}px;

    --block_width_phone: {{block_width_phone}};

    
}

{% endstyle %} 


<div class="color-{{ color_scheme }} gradient title-style">

       <div class="title_left">
            {%  unless subtitle == blank %} <h5>{{subtitle}}</h5> {% endunless %}  
            {%  unless title == blank %} <h2 class="title_{{title_size}}">{{title}}</h2> {% endunless %}  
            {%  unless content == blank %} <div class="content">{{content}}</div>    {% endunless %}  

            {% render 'btn', 
                btn_text:btn_text, 
                btn_url:btn_url, 
                btn_style:btn_style  
            %}
       </div> 
       <div class="google_review_block"> 
        <div class="google_review">
                {{ logo |  
                image_url: width: 500 |  
                image_tag  }}
                <h3>{{rating}}</h3>
                <p>{{review_text}}</p>

        </div>
       </div>

</div>


{%  schema  %}
{
    "name": "Review Title",
    "class": "block-title review-title",
    "tag":"div", 
    "settings": [

        {
            "type": "text",
            "id": "subtitle",
            "label": "Sub Title",
            "default":"Sub Title"
        },
        {
            "type": "inline_richtext",
            "id": "title",
            "label": "Title",
            "default":"Single Title"
        },
        {
            "type": "richtext",
            "id": "content",
            "label": "Content",
            "default":"<p>Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam. Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam.</p>"
        }, 


                 
        {
            "type": "text",
            "id":"btn_text",
            "label": "Button Text",
            "default":"BEKIJK VACATURE"
        },
        {
            "type": "url",
            "label": "Button Link",
            "id": "btn_url"
        },
        {
            "type": "select",
            "id": "btn_style",
            "label": "Button Style",
            "default":"filled",
            "options": [
                {
                    "value": "filled",
                    "label": "Filled"
                },
                {
                    "value": "outline",
                    "label": "Outline"
                },
                {
                    "value": "linked",
                    "label": "Linked"
                }
            ]
        },
        {
            "type": "header",
            "content": "Google Review"
        },
        {
            "type": "image_picker",
            "id": "logo",
            "label": "Google Logo"
        },
        {
            "type": "inline_richtext",
            "id":"review_text",
            "label":"Review Text",
            "default":"Gebaseerd op 175+ reviews",
        },
        {
            "type": "range",
            "min": 1,
            "max": 5,
            "step": 0.5,
            "default": 4.5,
            "label": "Rating",
            "id": "rating"
        },
        {
            "type": "header",
            "content": "Style"
        } ,
         
        {
            "type": "select",
            "id": "block_width",
            "label": "Block Width",
            "options": [
                { "value": "20%", "label": "20%" },
                { "value": "25%", "label": "25%" },
                { "value": "33.33%", "label": "33.33%" },
                { "value": "40%", "label": "40%" },
                { "value": "50%", "label": "50%" },
                { "value": "60%", "label": "60%" },
                { "value": "66.66%", "label": "66.66%" },
                { "value": "75%", "label": "75%" },
                { "value": "80%", "label": "80%" },
                { "value": "100%", "label": "100%" }
            ],
            "default":"100%"
        },


        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Slide Color",
            "default": "scheme-1"
        },
        {
            "type": "range",
            "id": "title_max_width",
            "label": "Title Max Width",
            "min": 400,
            "max": 1000,
            "unit": "px",
            "step": 10,
            "default": 700 
        },
        {
            "type": "select",
            "id": "title_size",
            "label": "Title Size",
            "default":"large",
            "options": [
                {"label": "Small","value": "small"},
                {"label": "Medium","value": "medium"},
                {"label": "Large","value": "large"},
                {"label": "Extra Large","value": "extralarge"} ,
                {"label": "Extra Extra Large","value": "extraextralarge"} 
            ]
        },
        {
            "type": "range",
            "id": "title_margin_bottom",
            "label": "Title Margin Bottom",
            "min": 0,
            "max": 100,
            "unit": "px",
            "step": 1,
            "default":30 
        },


        {
            "type": "range",
            "id": "content_max_width",
            "label": "Content Max Width",
            "min": 400,
            "max": 1000,
            "unit": "px",
            "step": 10,
            "default": 500 
        },
         {
            "type": "range",
            "id": "block_padding_horizontal",
            "label": "Horizontal Padding",
            "min": 0,
            "max": 100,
            "unit": "px",
            "step": 10,
            "default":30 
        },
         {
            "type": "range",
            "id": "block_padding_vertical",
            "label": "Vertical Padding",
            "min": 0,
            "max": 100,
            "unit": "px",
            "step": 10,
            "default":30 
        },

        {
            "type": "header",
            "content": "Mobile Responsive"
        },
         
        {
            "type": "select",
            "id": "block_width_phone",
            "label": "Block Width",
            "options": [
                { "value": "20%", "label": "20%" },
                { "value": "25%", "label": "25%" },
                { "value": "33.33%", "label": "33.33%" },
                { "value": "40%", "label": "40%" },
                { "value": "50%", "label": "50%" },
                { "value": "60%", "label": "60%" },
                { "value": "66.66%", "label": "66.66%" },
                { "value": "75%", "label": "75%" },
                { "value": "80%", "label": "80%" },
                { "value": "100%", "label": "100%" }
            ],
            "default":"100%"
        } 
    ],
    "presets": [
        {
            "name": "Review Title"
        }
    ]
}
{% endschema %}


{%  stylesheet  %} 
.block-title{
    flex-basis: var(--block_width);
    max-width: var(--block_width);

    @media screen and (max-width: 767px) {
       flex-basis:  var(--block_width_phone);
        max-width: var(--block_width_phone);
    }
}
.block-title .title-style{
    padding: var(--block_padding_vertical) var(--block_padding_horizontal);
}

.block-title h5{ 
    color:  rgb(var(--color-link)); 
font-weight: 600; 
font-size: 25px; 
line-height: 90%;
letter-spacing: 0%;
margin-bottom: 35px;

}
.block-title h2{
    max-width: var(--title_max_width);
    margin-bottom: var(--title_margin_bottom);
    
}
.block-title .content{
    max-width: var(--content_max_width);
}

.review-title{

    .title-style{
            display: flex;
            gap: 10px;
            justify-content: space-between; 
            align-items: flex-end;

        .title_left{} 

        .google_review_block{
            .google_review{ 
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    padding: 25px 30px 13px;
                    gap: 28px;

                    border: 3px solid #3C5358;
                    border-radius: 25px;

                img{ 
                    width: 57px;
                    height: auto;
                }
                h3{ 
                    font-size: 80px;
                    font-family: var(--nohemi);
                } 
                p{
                     display: flex;
                    flex-direction: column;
                    margin: 0;
                    font-size: 12px;
                    color: #fff;
                    opacity: 0.5;
                    strong{
                        color: #fff;
                    } 
                } 
            

            }
        } 
    }
}   

