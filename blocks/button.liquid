{% liquid  

    assign btn_text = block.settings.btn_text
    assign btn_link = block.settings.btn_link
    assign btn_style = block.settings.btn_style


    assign btnstyle = ''
    if btn_style == 'solid'
        assign btnstyle = 'btn_solid'
    elsif btn_style == 'outline'
        assign btnstyle = 'btn_outline'
    elsif btn_style == 'link'
        assign btnstyle = 'btn_link'
    endif

%}
 
<div class="color-{{ block.settings.color_scheme }} gradient">

    {% if btn_link != blank %}
        <a href="{{ btn_link }}" class="{{ btnstyle }}">{{ btn_text }}</a>
    {% endif %}
</div>


{%  style  %}
    #shopify-block-{{block.id}}{
        div{ 
            padding: 20px; 
            a{
               display:inline-block;
               padding:5px 20px;

               &.btn_solid{
                    background-color: rgb(var(--color-button)); 
                    color: rgb(var(--color-button-text)); 
                }
                &.btn_outline{
                    background-color: transparent; 
                    color: rgb(var(--color-button-text)); 
                    border: 1px solid rgb(var(--color-button));
                }
                  
                &.btn_link{
                    background-color: transparent; 
                    color: rgb(var(--color-button-text));  
                    border-bottom:1px solid rgb(var(--color-button));
                }
                  
            }
            
        }
    }
     
{% endstyle %}

{%  schema  %} 
{
    "name": "button",
    "class": "custom_btn",
    "settings": [
        {
            "type": "text",
            "id": "btn_text",
            "label": "Button Text",
            "default":"Buy Now"
        },
        {
            "type": "url",
            "id": "btn_link",
            "label": "Button Link" 
        },

        {
            "type": "header",
            "content": "Button Style"
        },
        {
            "type": "select",
            "options": [
                {
                    "value":"solid",
                    "label": "Solid"
                },
                {
                    "value":"outline",
                    "label": "Outline"
                },
                {
                    "value":"link",
                    "label": "Link"
                }
            ],
            "id": "btn_style",
            "label": "Button Style",
            "default":"solid"
        },
          
        {
            "type": "color_scheme",
            "id": "color_scheme",
            "label": "Button Color",
            "default": "scheme-2"
        }  
    ],
    "presets": [
        {
             "name": "button"
        }
    ]

}
{% endschema %} 