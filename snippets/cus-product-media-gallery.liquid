{% comment %} {{ product | json }} {% endcomment %}
<div class="product_slider_main">


{%  assign media_style =  section.settings.media_style %}
 

    {% unless product.metafields.custom.best_seller == blank %}
    <div class="product_badge">
        <span>{{product.metafields.custom.best_seller}}</span> 
    </div>
    {% endunless %}

    
    {%  assign brand_logo =  product.metafields.custom.brand_logo_image.value %} 
    {% unless brand_logo == blank %}
    <div class="product_brand_logo">
         {{ brand_logo.logo |  image_url: width: 150 |  image_tag }}
    </div>
    {% endunless %}
 
  
  
    {%  assign variant_media = product.selected_or_first_available_variant.featured_media %}


      {% if media_style == 'columns' %}
        <section 
        class=" product_columns" 
        aria-label="  Basic HTML Example"  
        data-variant-media='{{ product.variants | map: "id" | json }}'
        id="product-columns-{{ section.id }}-{{ product.id }}"
        data-product-id="{{ product.id }}">

          <div class="product_columns_grid">

          {% for media in product.media %}
              <div class="product_media  " data-media-id="{{ media.id }}">

              {% if media.media_type == 'image' %}
                <img
                  src="{{ media | image_url: width: 1400 }}"
                  width="100%"
                  height="auto"
                  alt="{{ product.title }}"
                > 
                 {% elsif media.media_type == 'video' %}
                          {%  echo media | media_tag: image_size: '100', autoplay: true, loop: loop, controls: true, preload: 'none' %}
              {% endif %}
              </div>
            {% endfor %} 

          </div>

        </section>
      {% endif %}

    {% if media_style == 'pagination' or media_style == 'thumbnail' %}
 
    <section 
    class="splide product_slider" 
    aria-label="Splide Basic HTML Example"  
    data-variant-media='{{ product.variants | map: "id" | json }}'
     id="product-slider-{{ section.id }}-{{ product.id }}"
      data-product-id="{{ product.id }}"
    > 

    <script type="application/json" data-variant-media-map>
        {
          {% for variant in product.variants %}
            "{{ variant.id }}": "{{ variant.featured_media.id | default: product.featured_media.id }}"{% unless forloop.last %},{% endunless %}
          {% endfor %}
        }
      </script> 
      
        <div class="splide__track">
            <ul class="splide__list">  
              {% for media in product.media %}
              <li class="splide__slide {% if media.id == variant_media.id %}is-active-initial{% endif %}" data-media-id="{{ media.id }}">

              {% if media.media_type == 'image' %}
                <img
                  src="{{ media | image_url: width: 1400 }}"
                  width="100%"
                  height="auto"
                  alt="{{ product.title }}"
                > 
                 {% elsif media.media_type == 'video' %}
                          {%  echo media | media_tag: image_size: '100', autoplay: true, loop: loop, controls: true, preload: 'none' %}
              {% endif %}
              </li>
            {% endfor %}  
            </ul>
        </div>



      {% if media_style == 'pagination'   %}

      <ul class="splide__pagination splide__pagination--ltr" role="tablist" aria-label="Select a slide to show"></ul>
      {%  elsif  media_style == 'thumbnail' %}
         
          <section
            id="thumbnail-carousel"
            class="splide thumbnailsplide"
            aria-label="The carousel with thumbnails. Selecting a thumbnail will change the Beautiful Gallery carousel."
          >
            <div class="splide__track">
              <ul class="splide__list">

              {% for media in product.media %}
                      <li class="splide__slide {% if media.id == variant_media.id %}is-active-initial{% endif %}" data-media-id="{{ media.id }}">
                       {% if media.media_type == 'image' %}
                         <img
                          src="{{ media | image_url: width: 1400 }}"
                          width="100%"
                          height="auto"
                          alt="{{ product.title }}"
                        >
                        {% elsif media.media_type == 'video' %}
                          {{ media.preview_image | image_url: width: 100 | image_tag: loading: 'lazy', alt: media.alt }}
                       {% endif %}
                      </li>
                    {% endfor %} 

                
              </ul>
            </div>
          </section> 
      {% endif %}




    </section> 

  {% endif %}

 </div>
 
{{ 'splide.min.css' |  asset_url  | stylesheet_tag }}
<script src="{{ 'splide.min.js' |  asset_url }}"></script>



<script>

 {% if media_style == 'pagination'   %}
  // Keep a registry so we can find each slider's Splide instance later
  window.__productSplideInstances = window.__productSplideInstances || {};

  function initSplideSliders(container) {
    var scope = container || document;
    var sliders = scope.querySelectorAll('.product_slider:not(.is-initialized)');

    sliders.forEach(function (el) {
      var splide = new Splide(el, {
        type: 'slide',
        perPage: 1,
        easing: 'cubic-bezier(0.25, 1, 0.5, 1)',
        classes: {
          pagination: 'splide__pagination your-class-pagination',
          page: 'splide__pagination__page',
        },
      });
      splide.mount();
      el.classList.add('is-initialized');

      // remember the instance + its variant->media map, keyed by the slider's id
      var mapScript = el.querySelector('script[data-variant-media-map]');
      var variantMediaMap = {};
      try { variantMediaMap = JSON.parse(mapScript.textContent); } catch (e) {}

      window.__productSplideInstances[el.id] = {
        splide: splide,
        variantMediaMap: variantMediaMap,
      };

      bindVariantChange(el);
    });
  }

  // Move the slider to the slide matching a given variant id
  function goToVariantSlide(sliderEl, variantId) {
    var entry = window.__productSplideInstances[sliderEl.id];
    if (!entry) return;

    var mediaId = entry.variantMediaMap[String(variantId)];
    if (!mediaId) return;

    var slides = sliderEl.querySelectorAll('.splide__slide');
    var index = -1;
    slides.forEach(function (slide, i) {
      if (slide.getAttribute('data-media-id') === String(mediaId)) {
        index = i;
      }
    });

    if (index > -1) {
      entry.splide.go(index);
    }
  }

  // Wire up listeners for variant changes.
  // Covers: 1) themes that dispatch a "variant:change" custom event,
  //         2) plain <select name="id"> / <input name="id"> variant pickers,
  //         3) hidden input[name="id"] updated silently by JS (via MutationObserver).
  function bindVariantChange(sliderEl) {
    var productId = sliderEl.getAttribute('data-product-id');

    // Find the product form associated with this slider.
    // Adjust this selector if your theme uses a different wrapper/attribute.
    var form = document.querySelector(
      'form[data-product-id="' + productId + '"], product-form form, form[action*="/cart/add"]'
    );
    if (!form) return;

    var idInput = form.querySelector('input[name="id"], select[name="id"]');
    if (!idInput) return;

    // 1) Standard change event (dropdowns, hidden select-based pickers)
    idInput.addEventListener('change', function () {
      goToVariantSlide(sliderEl, idInput.value);
    });

    // 2) Theme-dispatched custom event, e.g. document.dispatchEvent(new CustomEvent('variant:change', {detail:{variant}}))
    document.addEventListener('variant:change', function (event) {
      var variant = event.detail && (event.detail.variant || event.detail);
      if (variant && variant.id) {
        goToVariantSlide(sliderEl, variant.id);
      }
    });

    // 3) Fallback: some swatch/radio pickers update the hidden input's value
    // via JS without firing a native "change" event — catch that too.
    var observer = new MutationObserver(function () {
      goToVariantSlide(sliderEl, idInput.value);
    });
    observer.observe(idInput, { attributes: true, attributeFilter: ['value'] });
  }

  document.addEventListener('DOMContentLoaded', function () {
    initSplideSliders();
  });

  document.addEventListener('shopify:section:load', function (event) {
    initSplideSliders(event.target);
  });

  document.addEventListener('shopify:block:select', function (event) {
    initSplideSliders(event.target.closest('.product_slider') ? event.target.closest('.splide').parentElement : document);
  });


{% endif %}  

 {% if media_style == 'thumbnail'   %}

  document.addEventListener('DOMContentLoaded', function () {
  var mainSliderEl = document.querySelector('.product_slider'); // adjust selector if multiple
  if (!mainSliderEl) return;

  var mainSlider = new Splide(mainSliderEl, {
    type: 'slide',
    perPage: 1,
    easing: 'cubic-bezier(0.25, 1, 0.5, 1)', 
    pagination: false,
    isNavigation: false,
    arrows: false
  });

  var thumbnails = new Splide('#thumbnail-carousel', {
    fixedWidth: 100,
    gap: 10,
    rewind: true,
    pagination: false,
    isNavigation: true, // recommended for thumbnail nav — lets clicking a thumb move the main slider
  });

  mainSlider.sync(thumbnails); // must happen before mount()
  mainSlider.mount();
  thumbnails.mount();

  mainSliderEl.classList.add('is-initialized');

  // ...variant map + bindVariantChange logic as before, using mainSlider instead of the old local `splide`
});
  {% endif %}
  
</script>