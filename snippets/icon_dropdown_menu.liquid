<div class="icon_dropdown_menu color-{{color}}">
      
    <h2>{{title}} </h2>
    <div class="icon_dropdown_menu_grid">
        <div class="icon_dropdown_list"> 
            {% for child in dropdown_data %} 

                {% capture icon_image %}
                    <span class="icons">
                        {{ 
                            child.object.metafields.custom.icon 
                            |  image_url: width: '100px' 
                            |  image_tag: 
                            class: 'media',
                            fetchpriority: 'high',
                            loading: 'lazy' 
                            
                        }}
                    </span>
                {% endcapture %}

                {% if child.type == 'product_link' or child.type == 'collection_link' %}
                     <a class="menu-item" href="{{child.url}}">
                        {{icon_image}} <span class="child_title">{{child.title}}</span> 
                        {% render 'icon-right-arrow' %}
                     </a> 
                {% else %}
                    <a class="menu-item" href="{{child.url}}">
                        <span class="child_title">{{child.title}}</span>   
                        {% render 'icon-right-arrow' %}
                    </a>
                {% endif %}

            {% endfor %}  
        </div>
        <div class="menu_sliderBox">   

                {% render 'menu_slider',
                
                        media_01: media_01,
                        btn_text_01: btn_text_01,
                        btn_url_01:btn_url_01 ,
                        media_02: media_02,
                        btn_text_02: btn_text_02,
                        btn_url_02:btn_url_02 ,
                        media_03: media_03,
                        btn_text_03: btn_text_03,
                        btn_url_03:btn_url_03 ,
                          %}
        </div>
    </div>
</div>

{%  style  %}
 
.menu_parent .dropdown_hover .icon_dropdown_menu {
    position: absolute;
     opacity: 1;  
     visibility: visible; 
    /* background-color: #3f7280; */
    width: 100%;
    left: 0;
    min-width: 950px;
    border-radius: 12px;
    padding: 10px;
    transform: translateY(30px);
    transition-duration:0.4s;
    border:1px solid #fff;
    padding:20px 30px
}
.menu_parent .dropdown_hover:hover .icon_dropdown_menu {
     opacity: 1;  
     visibility: visible; 
    transform: translateY(0);

}
.icon_dropdown_menu_grid {
    /* display: grid;
    grid-template-columns: 3.5fr 2fr; */
    margin-top: 30px;
    gap: 0;

    width: 100%;
    display: flex;
    flex-wrap: wrap;
    
}

.icon_dropdown_list{
       display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 30px; 
    flex-basis:65%;
    max-width:65%;
}

.icon_dropdown_list a {
    display: flex !important;
    gap: 5px;
    align-items: center;
    padding: 0 !important; 
    border-radius: 100px !important;
    position:relative;
    overflow: hidden;
    justify-content:space-between;
}

.icon_dropdown_list a:not(:has(.icons)) {
    padding-left: 18px !important;
}
 
.icon_dropdown_list a .child_title{
flex-grow:1;
}
.icon_dropdown_list a svg{
   
    fill: #52b099;
    transform: translateX(-60px);
    opacity: 0;
    transition-duration: 0.3s;
}

.icon_dropdown_list a:hover svg{

    transform: translateX(-15px);
    opacity: 1;

}
.icon_dropdown_list a:hover{
    background-color:transparent !important;
}

.icon_dropdown_list a::after {
    content: '';
    background: #020922;
    position: absolute;
    top: 0;
    left: 0;
    width: 50%;
    height: 100%;
    z-index: -1;
    opacity:0;
    transition-duration:0.3s;
}
.icon_dropdown_list a:hover::after{
    width: 100%;
    opacity:1;

}
.icon_dropdown_list a span.icons {
    width: 40px;
    height: 40px;
    padding: 7px;
    border: 1px solid #52b099;
    border-radius: 100%;
    position:relative;
    overflow:hidden;
}
.icon_dropdown_list a span.icons::after{
    content:"";
    background-color:#52b099;
    position:absolute;
    width:100%;
    height:100%;
    top:0;
    left:0;
    border-radius: 100%;
    transform:scale(0.8);
    opacity:0;
    transition:all 0.3s ease;
} 
.icon_dropdown_list a span.icons img{
       width: 100%;
    object-fit: contain;
    height: 100%;
    position:relative;
    z-index:1;
}
.icon_dropdown_list a:hover span.icons::after{

    transform:scale(1);
    opacity:1;

}
.menu_sliderBox{

    flex-basis:35%;
    max-width:35%;
}
{% endstyle %}  