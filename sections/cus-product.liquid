
<div class="page-width">
    <div class="grid">
        <div class="product-media">
            
            <img class="media" src="{{ product.featured_image |  image_url: width: 1000  }}" /> 
        </div>
        <div class="product-info">
            <h2>{{product.title}}</h2>

            <div class="price-info">
                <div class="product-price">{{ product.selected_or_first_available_variant.price |  money}}</div>


                {% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
                    {% assign hidden = 'hidden' %}
                {% endunless %}

                <del class="product-compare-price {{hidden}}">
                    {{  product.selected_or_first_available_variant.compare_at_price | money}}
                </del>
            </div>

            {%  form  'product', product %} 

               

                <input id="product-id" name="id" type="hidden" value="{{product.selected_or_first_available_variant.id}}">

                <div class="product-option">
                    {% for option in product.options_with_values %}
                        <div class="variant_options">
                            <strong>{{option.name}}</strong>
                            {% for value in option.values %}
                                <div>
                            <input {% if option.selected_value == value %}checked{% endif %} name="{{option.name}}" type="radio" value="{{value}}" id="{{option.name |  handleize}}-{{value  |  handleize }}">
                                    <label for="{{option.name |  handleize}}-{{value  |  handleize }}">{{value }}</label>
                                </div>
                            {% endfor %}

                        </div>
                    {% endfor %}
                </div>


                <div class="quantity-selector">
                    <button type="button" class="quantity-minus">-</button>
                    <input type="text" id="quantity"  name="quantity" value="1" >
                    <button type="button" class="quantity-plus">+</button>
                </div>

                 
                
            
                <button 
                    type="submit" 
                    id="add_to_cart"
                    {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}
                >
                    {% if product.selected_or_first_available_variant.available %}
                        Add to Cart
                    {% else %}
                       Sold Out
                    {% endif %}
                </button>

                <button id="buy_now" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
                    buy now
                </button>



            {% endform %} 

        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/url-parse@1.5.10/dist/url-parse.min.js" integrity="sha256-0CWWBJrf1D+RzXxYmL4gqZdeZUw76w7jB/j7JygXddY=" crossorigin="anonymous"></script>


    <script src="{{ 'money-format.js' | asset_url }}" defer="defer"></script>


<script>
    let product = {{product | json}}
    //console.log(product.variants)

    document.querySelectorAll('.product-option input[type="radio"]').forEach(radio =>{
        radio.addEventListener('change', ()=> {


            var selectedOptions = []
            document.querySelectorAll('.product-option input[type="radio"]:checked').forEach(data => { 
                selectedOptions.push(data.value)
            })
            //console.log(selectedOptions)

 

            const foundVariant = product.variants.find(variant => { 
            return selectedOptions.every((option, index) => { 
                const variantOptionValue = variant[`option${index + 1}`];
                return variantOptionValue === option;
            });
            });

            //console.log(foundVariant);

            var url = new URL(window.location.href)
            url.searchParams.set('variant',foundVariant.id)
            window.history.replaceState({},'',url.toString())
            //console.log(url.toString())



             document.querySelector('.product-price').textContent = formatMoney(foundVariant.price, "{{ shop.money_format }}")
             document.querySelector('.product-compare-price').textContent = formatMoney(foundVariant.compare_at_price, "{{ shop.money_format }}")
             

            if(foundVariant.compare_at_price > foundVariant.price){
                document.querySelector('.product-compare-price').classList.remove('hidden')
            } else { 
                document.querySelector('.product-compare-price').classList.add('hidden')

            }

            

            let add = document.querySelector("#add_to_cart")
            let buy = document.querySelector("#buy_now")

            if(foundVariant.available){
                buy.disabled = false
                add.disabled = false
                add.textContent = "Add To Cart" 
            } else {
                add.disabled = true
                buy.disabled = true
                add.textContent = "SOLD OUT"  
            } 




        })
    });


 
     document.querySelector("#buy_now").addEventListener('click', (e)=>{

        e.preventDefault();
 

        let form = document.querySelector('.shopify-product-form')
 
            let input = document.createElement('input')
            input.value = '/checkout/'
            input.name = 'return_to'
            input.type = 'hidden'

            form.appendChild(input) 
        form.submit();
        console.log(input)
    })


    // <input type="hidden" name="return_to" value="/checkout">




    document.querySelector('.quantity-selector .quantity-plus').addEventListener('click', ()=>{

        let quantity = Number(document.querySelector('#quantity').value) ;
         document.querySelector('#quantity').value  = quantity  + 1
        

    })
    document.querySelector('.quantity-selector .quantity-minus').addEventListener('click', ()=>{

        let quantity = Number(document.querySelector('#quantity').value) ;

        if(quantity > 1){
         document.querySelector('#quantity').value  = quantity  - 1
        }
        

    })

 


    document.querySelectorAll('form[action="/cart/add"]').forEach((form)=>{

            form.addEventListener('submit', async(event) => {
                event.preventDefault()

                const button = form.querySelector("#add_to_cart") 
                button.disabled = true 
                button.textContent = 'adding'

                try{
                   const formdata = new FormData(form) 
                   const response = await fetch('/cart/add.js', {

                    method: 'POST',
                    headers: {
                            'Accept': 'application/javascript',
                            'X-Requested-With': 'XMLHttpRequest' 
                    },
                    body: formdata 
                   })

                   const data = await response.json()
                   console.log(data)

                   const cartResponse =  await fetch('/cart.js')
                   const cart = await cartResponse.json()
                   console.log(cart.item_count)



                //    let cartBuble = document.querySelector('.cart-count-bubble span[aria-hidden="true"]')
                //    let cartBubleHidden = document.querySelector('.cart-count-bubble span[class="visually-hidden"]')


                    let cartIconBubble = document.querySelector('#cart-icon-bubble');
                    let cartBuble = document.querySelector('.cart-count-bubble')

                     if(cart.item_count > 0 ){ 

                        if(!cartBuble){
                            let bubble = document.createElement('div')
                            bubble.className = 'cart-count-bubble'

                            bubble.innerHTML = `
                                <span aria-hidden="true">${cart.item_count}</span><span class="visually-hidden">${cart.item_count} item</span>
                            ` 
                            cartIconBubble.appendChild(bubble)

                        } else if(cartBuble){

                             cartBuble.innerHTML = `
                                <span aria-hidden="true">${cart.item_count}</span><span class="visually-hidden">${cart.item_count} item</span>
                            ` 
                            
                        } 

                    }





                    

 


                //  const cart_drawer = document.querySelector('cart-drawer.drawer');
                //  cart_drawer.classList.add('active')



                //   cart_drawer_info.innerHTML = ``


                //cart-drawer


                //    if(response){
                //     console.log('hurrah')
                //    }

                   
                 button.disabled = false 
                button.textContent = 'Add to Cart'


                   

                } catch(error){
                    console.log('errror')
                    console.error(error)
                }





                 
            } )

    })


</script>



